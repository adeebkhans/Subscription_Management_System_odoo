generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  GOODS
  SERVICE
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String
  role                UserRole  @default(CUSTOMER)
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  createdProducts      Product[]           @relation("ProductCreatedBy")
  createdPlans         Plan[]              @relation("PlanCreatedBy")
  createdTemplates     QuotationTemplate[] @relation("TemplateCreatedBy")
  subscriptions        Subscription[]      @relation("SubscriptionCustomer")
  createdSubscriptions Subscription[]      @relation("SubscriptionCreatedBy")

  @@index([role, isActive])
  @@map("users")
}

model Product {
  id                String                  @id @default(uuid()) @db.Uuid
  name              String
  type              ProductType
  salesPrice        Decimal                 @db.Decimal(12, 2) @map("sales_price")
  costPrice         Decimal                 @db.Decimal(12, 2) @map("cost_price")
  notes             String?
  isActive          Boolean                 @default(true) @map("is_active")
  createdById       String?                 @db.Uuid @map("created_by_id")
  createdBy         User?                   @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@index([type, isActive])
  @@map("products")
}

model ProductVariant {
  id                String                  @id @default(uuid()) @db.Uuid
  productId         String                  @db.Uuid @map("product_id")
  attribute         String
  value             String
  extraPrice        Decimal                 @default(0) @db.Decimal(12, 2) @map("extra_price")
  isActive          Boolean                 @default(true) @map("is_active")
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model Plan {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  price           Decimal              @db.Decimal(12, 2)
  frequency       BillingFrequency
  minimumQuantity Int                  @default(1) @map("minimum_quantity")
  availableFrom   DateTime?            @map("available_from")
  availableUntil  DateTime?            @map("available_until")
  autoClose       Boolean              @default(false) @map("auto_close")
  allowEarlyClose Boolean              @default(true) @map("allow_early_close")
  allowPause      Boolean              @default(true) @map("allow_pause")
  allowRenew      Boolean              @default(true) @map("allow_renew")
  isActive        Boolean              @default(true) @map("is_active")
  createdById     String?              @db.Uuid @map("created_by_id")
  createdBy       User?                @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  templates       QuotationTemplate[]
  subscriptions   Subscription[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([frequency, isActive])
  @@map("plans")
}

model PaymentTerm {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  dueDays       Int            @default(0) @map("due_days")
  isActive      Boolean        @default(true) @map("is_active")
  subscriptions Subscription[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("payment_terms")
}

model QuotationTemplate {
  id            String                  @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  validityDays  Int                     @map("validity_days")
  planId        String?                 @db.Uuid @map("plan_id")
  plan          Plan?                   @relation(fields: [planId], references: [id], onDelete: SetNull)
  isActive      Boolean                 @default(true) @map("is_active")
  createdById   String?                 @db.Uuid @map("created_by_id")
  createdBy     User?                   @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String            @db.Uuid @map("template_id")
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String            @db.Uuid @map("product_id")
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String?           @db.Uuid @map("variant_id")
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int               @default(1)
  unitPrice  Decimal?          @db.Decimal(12, 2) @map("unit_price")
  taxRate    Decimal           @default(0) @db.Decimal(5, 2) @map("tax_rate")
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@index([templateId])
  @@map("quotation_template_lines")
}

model Subscription {
  id                  String             @id @default(uuid()) @db.Uuid
  number              String             @unique
  customerId          String             @db.Uuid @map("customer_id")
  customer            User               @relation("SubscriptionCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  planId              String             @db.Uuid @map("plan_id")
  plan                Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @map("start_date")
  expiryDate          DateTime?          @map("expiry_date")
  paymentTermId       String?            @db.Uuid @map("payment_term_id")
  paymentTerm         PaymentTerm?       @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  quotationTemplateId String?            @db.Uuid @map("quotation_template_id")
  quotationTemplate   QuotationTemplate? @relation(fields: [quotationTemplateId], references: [id], onDelete: SetNull)
  quotationValidUntil DateTime?          @map("quotation_valid_until")
  subtotal            Decimal            @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal            @default(0) @db.Decimal(12, 2) @map("tax_total")
  total               Decimal            @default(0) @db.Decimal(12, 2)
  notes               String?
  cancelledReason     String?            @map("cancelled_reason")
  pausedAt            DateTime?          @map("paused_at")
  closedAt            DateTime?          @map("closed_at")
  renewedFromId       String?            @unique @db.Uuid @map("renewed_from_id")
  renewedFrom         Subscription?      @relation("SubscriptionRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewal             Subscription?      @relation("SubscriptionRenewal")
  createdById         String?            @db.Uuid @map("created_by_id")
  createdBy           User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines               SubscriptionLine[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([status, startDate])
  @@index([customerId, status])
  @@index([planId, status])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String          @id @default(uuid()) @db.Uuid
  subscriptionId String          @db.Uuid @map("subscription_id")
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String          @db.Uuid @map("product_id")
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?         @db.Uuid @map("variant_id")
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description    String?
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2) @map("unit_price")
  taxRate        Decimal         @default(0) @db.Decimal(5, 2) @map("tax_rate")
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2) @map("tax_amount")
  lineAmount     Decimal         @db.Decimal(12, 2) @map("line_amount")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([subscriptionId])
  @@map("subscription_lines")
}

model Sequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sequences")
}
